{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R-Base Projekt-Konfiguration",
  "type": "object",
  "required": ["configVersion", "schemas", "settings"],
  "properties": {
    "configVersion": { "const": 1 },
    "schemas": {
      "type": "object",
      "required": ["configVersion", "defaultSchemaId", "schemas"],
      "properties": {
        "configVersion": { "const": 1 },
        "defaultSchemaId": { "type": "string", "minLength": 1 },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "dataset-schema-config.schema.json#/$defs/datasetSchema" }
        }
      }
    },
    "settings": {
      "type": "object",
      "required": ["webdav"],
      "properties": {
        "webdav": {
          "type": "object",
          "properties": {
            "baseUrl": { "type": "string" },
            "username": { "type": "string" }
          }
        }
      }
    }
  }
}